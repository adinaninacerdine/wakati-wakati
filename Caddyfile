# ============================================================
# GED WAKATI — Caddy
# ============================================================
# Le certificat HTTPS est obtenu et renouvelé automatiquement par
# Let's Encrypt. Prérequis : l'enregistrement DNS ged.wakati.km doit
# pointer vers l'adresse IP du VPS AVANT le premier démarrage.

ged.wakati.km {

    encode gzip

    # --- En-têtes de sécurité ---------------------------------
    header {
        # Impose HTTPS pendant un an, y compris sur les sous-domaines.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"

        # L'application ne doit jamais être affichée dans un cadre :
        # protection contre le détournement de clic.
        X-Frame-Options "DENY"

        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"

        # Masque la nature du serveur applicatif.
        -Server
    }

    # --- Journalisation ---------------------------------------
    log {
        output file /data/ged-acces.log {
            roll_size 10mb
            roll_keep 10
        }
        format json
    }

    reverse_proxy ged:5000 {
        # L'envoi d'un PDF en signature peut être long sur liaison lente.
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}

# ------------------------------------------------------------
# VARIANTE — proxy déjà en place (installation Odoo)
# ------------------------------------------------------------
# Si un Caddy existe déjà sur le VPS, ne pas démarrer un second :
# ajouter uniquement le bloc ci-dessus à son Caddyfile, puis recharger :
#
#   docker exec -w /etc/caddy <conteneur_caddy> caddy reload
#
# Sous Nginx, l'équivalent minimal est :
#
#   server {
#       server_name ged.wakati.km;
#       client_max_body_size 25M;
#       location / {
#           proxy_pass http://127.0.0.1:5000;
#           proxy_set_header Host $host;
#           proxy_set_header X-Forwarded-Proto $scheme;
#           proxy_read_timeout 300s;
#       }
#   }
